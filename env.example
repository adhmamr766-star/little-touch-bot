# من BotFather على تيليجرام بعد ما تعملي بوت جديد بـ /newbot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# رقم الشات اللي هتوصله الإشعارات (شخصي أو جروب) - شوفي README عشان تجيبيه
TELEGRAM_CHAT_ID=123456789

# أي نص سري تختاريه، وتحطيه في الموقع برضه، عشان محدش غير موقعك يقدر يبعت طلبات للسيرفر
SHARED_SECRET=change-this-to-something-random

# المتصفحات المسموحلها تنادي السيرفر (رابط موقعك بعد النشر). * لو لسه بتجربي
ALLOWED_ORIGIN=*

PORT=3000
